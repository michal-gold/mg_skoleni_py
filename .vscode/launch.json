{
    "version": "0.2.0",
    "configurations": [
        // ===========================================================================
        // VARIANTA 1: UNIVERZÁLNÍ ŠVÝCARSKÝ NŮŽ
        // Spustí aktivní soubor a umožní importovat cokoli od školitele.
        // ===========================================================================
        {
            "name": "1. Spustit z mg_skoleni_py",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}", 
            //"cwd": "${fileDirname}", 
            "cwd": "${workspaceFolder}", // Nastaví pracovní plochu na hlavní složku projektu
            
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            //"python": "C:/Skoleni_Python/Skoleni_Py/moje_pokusy/.venv/Scripts/python.exe",
            "justMyCode": true,
            // ENV: Nastavení proměnných prostředí pro tento běh
            "env": {
                // PYTHONPATH říká Pythonu: "Když hledáš moduly přes 'import', 
                // podívej se kromě svých složek i do složky od_skolitele."
                // ${workspaceFolder}/.. nás posune o úroveň výš, kde obě složky sousedí.
                "PYTHONPATH": "${workspaceFolder}/../rd-python-industrial-automation-v2"
            }
        },
        /*
        // ===========================================================================
        // VARIANTA 2: FIXNÍ START (ENTRY POINT)
        // Vždy spustí váš hlavní projekt a zpřístupní školitelovy funkce.
        // ===========================================================================
        {
            "name": "2. Spustit hlavní projekt (Slozka_A)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/slozka_alfa/main.py",
            "cwd": "${workspaceFolder}/slozka_alfa",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "justMyCode": true,
            "env": {
                // Umožňuje vašemu hlavnímu skriptu importovat školitelovy soubory
                "PYTHONPATH": "${workspaceFolder}/../rd-python-industrial-automation-v2"
            }
        },

        // ===========================================================================
        // VARIANTA 3: SPUŠTĚNÍ JAKO MODUL (-m)
        // Nejstabilnější cesta pro komplexní importy napříč složkami.
        // ===========================================================================
        {
            "name": "3. Spustit jako Python Modul",
            "type": "debugpy",
            "request": "launch",
            "module": "slozka_beta.hlavni_skript", 
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "justMyCode": true,
            "env": {
                // Zde PYTHONPATH zajistí, že i při spuštění jako modul 
                // uvidí Python sousední složku se školitelovými daty/kódem.
                "PYTHONPATH": "${workspaceFolder}/../rd-python-industrial-automation-v2"
            }
        }
        */
    ]
}
